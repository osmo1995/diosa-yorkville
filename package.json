{
  "name": "diosa-studio-yorkville",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/index.mjs",
    "dev:full": "npm-run-all -p dev:api dev",
    "build": "vite build",
    "preview": "vite preview",
    "gemini:models": "node scripts/listGeminiModels.mjs",
    "gemini:images": "node scripts/generateGeminiImages.mjs",
    "gemini:images:3pro": "node scripts/generateGeminiImages.mjs --model=models/gemini-3-pro-image-preview",
    "gemini:images:force": "node scripts/generateGeminiImages.mjs --force",
    "gemini:images:3pro:force": "node scripts/generateGeminiImages.mjs --model=models/gemini-3-pro-image-preview --force",
    "gemini:style-previews": "node scripts/generateStylePreviews.mjs",
    "gemini:style-previews:3pro": "node scripts/generateStylePreviews.mjs --model=models/gemini-3-pro-image-preview",
    "gemini:style-previews:force": "node scripts/generateStylePreviews.mjs --force",
    "gemini:style-previews:3pro:force": "node scripts/generateStylePreviews.mjs --model=models/gemini-3-pro-image-preview --force",
    "gemini:regen:all:3pro:force": "npm run gemini:images:3pro:force && npm run gemini:style-previews:3pro:force"
  },
  "dependencies": {
    "@iconify-json/fluent": "^1.2.37",
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify/react": "^6.0.2",
    "@react-three/fiber": "^9.5.0",
    "express": "^4.21.2",
    "formidable": "^3.5.2",
    "framer-motion": "^12.29.2",
    "nodemailer": "7.0.12",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.33.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
